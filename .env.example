# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional overrides. Any OpenAI-compatible endpoint works, e.g. Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_PASSES=3

# Only needed if tesseract.exe is not on PATH or in the default install folder
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
